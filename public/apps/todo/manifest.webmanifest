{
  "id": "./",
  "name": "iTodoist",
  "short_name": "iTodoist",
  "description": "Encrypted, local-first tasks with plain-language capture, a two-week horizon and focus sessions.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0b0c10",
  "theme_color": "#0b0c10",
  "categories": ["productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Upcoming", "url": "./?view=upcoming", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Pulse", "url": "./?view=pulse", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
